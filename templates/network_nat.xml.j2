<network>
  <name>{{ item.name }}</name>
  <bridge name='{{ item.bridge | default("virbr" ~ (loop.index)) }}'/>
  <forward mode='nat'/>
  <ip address='{{ item.ip }}' netmask='{{ item.netmask | default("255.255.255.0") }}'>
{% if item.dhcp_start is defined and item.dhcp_end is defined %}
    <dhcp>
      <range start='{{ item.dhcp_start }}' end='{{ item.dhcp_end }}'/>
{% if item.dhcp_hosts is defined %}
{% for host in item.dhcp_hosts %}
      <host mac='{{ host.mac }}' name='{{ host.name }}' ip='{{ host.ip }}'/>
{% endfor %}
{% endif %}
    </dhcp>
{% endif %}
  </ip>
</network>
